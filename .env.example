# Copy to .env and fill in values. Never commit .env (already gitignored).

# TypeSafe (JEV) — https://console.typesafe.ai/keys
TYPESAFE_API_KEY=

# Telegram bot that delivers the report (create via @BotFather)
TELEGRAM_BOT_TOKEN=
# Target group chat id (negative number for groups, e.g. -1001234567890)
TELEGRAM_GROUP_ID=
